      "id": "2fc6baba-ae2c-4e4c-b53b-ff9cd663df4c",
      "name": "Capture all files"
    },
    {
      "parameters": {
        "jsCode": "// 1. Grab the raw text list of files from the shell execution\nconst rawOutput = $input.first().json.stdout;\n\n// 2. Split by newlines and filter out any accidental empty lines\nconst filesArray = rawOutput.split('\\n').map(name => name.trim()).filter(name => name.length > 0);\n\n// 3. Map into an n8n array format so each file is its own item\nreturn filesArray.map(filename => {\n  return {\n    json: { name: filename }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -368,
        -64
      ],
      "id": "49126d5d-6894-4bf4-8a18-04461711cdec",
      "name": "Prep file names"
    },
    {
      "parameters": {
        "jsCode": "// 1. Grab the first item from the AI Agent's results\nconst inputItem = $('AI Agent').first();\n\n// 2. Extract the 'output' string\nconst rawText = inputItem.json.output;\n\n// 3. Clean up any rogue formatting wrappers (like ```json)\nconst cleanText = rawText.replace(/```json|```/g, \"\").trim();\n\n// 4. Parse the string into a real JavaScript array\nconst itemsArray = JSON.parse(cleanText);\n\n// 5. Map the array into standard n8n format so each item gets its own row\nreturn itemsArray.map(item => {\n  return {\n    json: item\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
