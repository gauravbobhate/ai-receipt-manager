    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a forensic financial accountant. Analyze the provided receipt image. \nExtract all items and return a JSON array. Do NOT include markdown formatting. Convert German Umlaut characters and other accented characters to their english versions. so \"ö\" becomes \"oe\" and etc.\n\nKeys for each object:\n- \"Shop Name\": Merchant name.\n- \"Receipt number\": The ID (or \"N/A\").\n- \"Item Name\": Description.\n- \"Quantity\": Integer.\n- \"Item Category\": [Groceries, Food - dining, Beverages, home decor, home maintenance, entertainment, Apparels, Work / Office, Transport, Travel, Personal / Health care, Gym / fitness, Gifts].\n- \"Date\": YYYY-MM-DD.\n- \"Cost\": Number (no currency symbol).\n- \"Currency\": e.g., EUR.\n- \"Purchase type\": [Essential: Fixed, Essential: Variable, Discretionary: Basic, Impulse, Splurge, Fancy].\n- \"AI Confidence score\": 0.0 to 1.0.\n- \"Photo Name\": {{ $node[\"Loop Over Items\"].json[\"name\"] }}",
        "options": {
          "passthroughBinaryImages": true
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        256,
        -16
      ],
      "id": "f6cc26b0-442c-428c-9985-6dd2c0d5d37a",
      "name": "AI Agent"
    },
